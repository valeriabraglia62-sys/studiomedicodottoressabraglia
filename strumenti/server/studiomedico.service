[Unit]
Description=Studio Medico Dottoressa Braglia - sito prenotazioni
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
# Se cade di continuo per un guasto serio, dopo 5 tentativi in 60s si ferma
# invece di riprovare all'infinito.
StartLimitIntervalSec=60
StartLimitBurst=5
Environment=NODE_ENV=production

# Il codice resta in sola lettura: il processo puo' scrivere SOLO dove servono
# davvero il database, i backup e i log. Cosi' una compromissione applicativa
# non puo' modificare il codice per ripresentarsi al riavvio.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__APP_DIR__/data __APP_DIR__/logs
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
