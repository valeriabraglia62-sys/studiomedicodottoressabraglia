# Configurazione per il SERVER Linux (Hetzner). setup-server.sh copia questo
# file in .env e riempie da solo SITO_URL, HOST_AMMESSI, SESSION_SECRET e
# BACKUP_ENCRYPTION_KEY. Il resto lo compili tu.

PORT=3000

# Sul server c'e' Caddy davanti che fornisce l'HTTPS: queste vanno cosi'.
SITO_HTTPS=true
SITO_URL=
HOST_AMMESSI=
PROXY_DAVANTI=1

# Account amministratore. La password si mette SOLO per il primo avvio, poi
# entri nel pannello, ne scegli una tua e QUI la lasci vuota.
ADMIN_EMAIL=auslvaleria@gmail.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_RESET=
SEGRETARIA_PASSWORD_RESET=
INBOX_MAX_MESSAGE_BYTES=15728640

# Riempita da setup-server.sh (openssl rand -hex 32)
SESSION_SECRET=

NOTIFY_EMAIL=auslvaleria@gmail.com

# Casella Gmail dello studio + password per le app (16 caratteri):
# https://myaccount.google.com/apppasswords
EMAIL_USER=auslvaleria@gmail.com
EMAIL_PASS=

INBOX_POLLING_ENABLED=true
INBOX_POLL_INTERVAL_SECONDS=120

# Google Fogli / Moduli: se li usi, riempi come nel .env attuale del PC.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID_PRENOTAZIONI=
GOOGLE_SHEET_ID_MEDICINE=
GOOGLE_SHEET_ID_ESAMI=
GOOGLE_SHEET_ID_SPECIALISTICHE=
GOOGLE_SERVICE_ACCOUNT_FILE=./google-credentials.json

GOOGLE_MODULI_ENABLED=false
GOOGLE_MODULO_PRENOTAZIONI_ID=
GOOGLE_MODULO_MEDICINE_ID=
GOOGLE_MODULO_SPECIALISTICHE_ID=
GOOGLE_MODULO_ESAMI_ID=
GOOGLE_MODULO_PRENOTAZIONI_SCHEDA=Risposte del modulo 1
GOOGLE_MODULO_MEDICINE_SCHEDA=Risposte del modulo 1
GOOGLE_MODULO_SPECIALISTICHE_SCHEDA=Risposte del modulo 1
GOOGLE_MODULO_ESAMI_SCHEDA=Risposte del modulo 1
GOOGLE_MODULI_INTERVAL_SECONDS=300

MODULO_PRENOTAZIONI_LINK=
MODULO_MEDICINE_LINK=
MODULO_SPECIALISTICHE_LINK=
MODULO_ESAMI_LINK=

# I backup restano sul server, in chiaro dentro data/backup solo un istante:
# vengono cifrati subito. La copia oraria verso OneDrive la fa backup-remoto.sh.
CARTELLA_BACKUP=/opt/studiomedico/data/backup

# Riempita da setup-server.sh (openssl rand -hex 32). ANNOTALA FUORI DAL SERVER.
BACKUP_ENCRYPTION_KEY=
