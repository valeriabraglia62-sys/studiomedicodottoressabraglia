# Configurazione per il SERVER Linux (VPS Aruba). setup-server.sh copia questo
# file in .env e riscrive da solo SITO_URL, HOST_AMMESSI, SESSION_SECRET e
# BACKUP_ENCRYPTION_KEY. Il resto lo compili tu.

PORT=3000

# Sul server c'e' Caddy davanti che fornisce l'HTTPS: queste vanno cosi'.
SITO_HTTPS=true
SITO_URL=https://studiomedicobragliavaleria.it
HOST_AMMESSI=studiomedicobragliavaleria.it,www.studiomedicobragliavaleria.it
PROXY_DAVANTI=1
NODE_ENV=production
# Il processo ascolta solo su loopback: da fuori si passa sempre da Caddy.
BIND_HOST=127.0.0.1

# Account amministratore. La password si mette SOLO per il primo avvio, poi
# entri nel pannello, ne scegli una tua e QUI la lasci vuota.
ADMIN_EMAIL=auslvaleria@gmail.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_RESET=
SEGRETARIA_PASSWORD_RESET=

# Riempita da setup-server.sh (openssl rand -hex 32)
SESSION_SECRET=

NOTIFY_EMAIL=auslvaleria@gmail.com

# Casella Gmail dello studio + password per le app (16 caratteri):
# https://myaccount.google.com/apppasswords
EMAIL_USER=auslvaleria@gmail.com
EMAIL_PASS=

# I backup restano sul server, in chiaro dentro data/backup solo un istante:
# vengono cifrati subito. La copia oraria verso OneDrive la fa backup-remoto.sh.
CARTELLA_BACKUP=/opt/studiomedico/data/backup

# Riempita da setup-server.sh (openssl rand -hex 32). ANNOTALA FUORI DAL SERVER.
BACKUP_ENCRYPTION_KEY=
