# Copia questo file in `.env` e inserisci i valori reali.
# `.env` e' escluso da git: i segreti non devono mai stare qui dentro.

PORT=3000

# Apertura su internet.
# Metti true SOLO quando il sito e' gia' raggiungibile con https://, cioe'
# quando davanti c'e' un proxy o un tunnel che fornisce il lucchetto.
# Attivato prima, il sito rimanda a un indirizzo sicuro che non esiste ancora.
SITO_HTTPS=false
SITO_URL=

# Account amministratore
ADMIN_EMAIL=valeriabraglia62@gmail.com
# Password in chiaro SOLO al primo avvio: il server la trasforma in hash
# e la salva nel database. Dopo il primo avvio puoi rimuoverla da .env.
ADMIN_PASSWORD=

# Chiave per firmare i token di sessione.
# Generala con: openssl rand -hex 32
SESSION_SECRET=

# Casella Gmail usata per inviare e leggere le richieste
EMAIL_USER=valeriabraglia62@gmail.com
# Password per le app Google (16 caratteri): https://myaccount.google.com/apppasswords
EMAIL_PASS=

# Lettura della casella in arrivo come rete di sicurezza (IMAP)
INBOX_POLLING_ENABLED=true
INBOX_POLL_INTERVAL_SECONDS=120

# Sincronizzazione Foglio Google (opzionale: se assente le richieste
# restano in coda nel database e vengono sincronizzate appena configurato)
GOOGLE_SHEETS_ENABLED=false
# Due fogli distinti. L'ID e' il pezzo di indirizzo fra /d/ e /edit:
# docs.google.com/spreadsheets/d/QUESTO_PEZZO/edit
GOOGLE_SHEET_ID_PRENOTAZIONI=
GOOGLE_SHEET_ID_MEDICINE=
GOOGLE_SERVICE_ACCOUNT_FILE=./google-credentials.json

# Moduli Google: la porta d'ingresso che resta aperta anche quando il sito e'
# spento. Il paziente compila il modulo, Google scrive la riga nel foglio delle
# risposte e il sito la raccoglie appena si riaccende. Sono i fogli generati dai
# Moduli, non quelli dello specchio qui sopra: qui il sito legge soltanto.
GOOGLE_MODULI_ENABLED=false
GOOGLE_MODULO_PRENOTAZIONI_ID=
GOOGLE_MODULO_MEDICINE_ID=
# Nome della scheda delle risposte dentro il foglio. Google la crea con questo
# nome da sola: cambialo solo se l'hai rinominata a mano.
GOOGLE_MODULO_PRENOTAZIONI_SCHEDA=Risposte del modulo 1
GOOGLE_MODULO_MEDICINE_SCHEDA=Risposte del modulo 1
GOOGLE_MODULI_INTERVAL_SECONDS=300
