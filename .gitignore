# Segreti — non deve MAI finire nel repository
#
# Anche le copie: prima di toccare il .env se ne fa una di sicurezza, e
# ".env.prima-di-qualcosa" contiene le stesse password del file vero. Con la
# sola riga ".env" quelle copie restavano scoperte, e sarebbero entrate nel
# primo "git add -A" senza che nessuno se ne accorgesse.
.env
.env.*
*.key.json
service-account*.json
google-credentials.json

# Database e backup
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Dipendenze
node_modules/

# Programmi esterni presi a mano: non sono nostri e non si versionano. NSSM
# serve solo sulla macchina Windows e si riscarica da https://nssm.cc/download,
# versione win64. Lo script strumenti/servizio-windows.ps1 lo cerca qui.
strumenti/nssm.exe

# Log
*.log
logs/

# Sistema
.DS_Store
Thumbs.db

# Impostazioni locali dell'editor
.claude/settings.local.json
